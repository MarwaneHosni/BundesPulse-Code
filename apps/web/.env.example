# BundesPulse web app environment template.
# Used by Vite (prefix env vars with VITE_ to expose them to the client).

# Where the Vite dev server proxies /api to. Override for remote backends.
# VITE_API_PROXY_TARGET=http://localhost:8000

# Where the client calls the API from. Default "/api" (same-origin, proxied in
# dev, reverse-proxied in production).
# VITE_API_BASE_URL=/api