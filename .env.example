# Shared environment templates (copy to .env as needed; none required to run).

# ---- Backend ----
# Absolute or repo-relative path to the immutable DuckDB snapshot. When unset,
# the backend starts without data access ("degraded" health) until the
# data-build phase produces data/snapshots/bundespulse.duckdb.
# BUNDESPULSE_SNAPSHOT=data/snapshots/bundespulse.duckdb

# ---- Web ----
# Where the Vite dev server proxies /api to. Override only for remote backends.
# VITE_API_PROXY_TARGET=http://localhost:8000