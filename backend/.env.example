# BundESPulse backend environment template.
# Copy to backend/.env (not committed). The backend reads environment variables
# from the process; there is no .env loader in the backend itself.

# Path to the immutable DuckDB snapshot (absolute or relative to repo root).
# When unset, no snapshot is attached (health = degraded).
# BUNDESPULSE_SNAPSHOT=data/snapshots/bundespulse.duckdb